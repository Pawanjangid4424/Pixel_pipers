# Copy this file to ".env" and fill in the values (Vite only exposes VITE_* variables).
# On Vercel, add the same two variables under Settings → Environment Variables.

# Flask backend URL – no slash at the end
#   local:        http://localhost:5001
#   live (Render): https://pixel-pipers.onrender.com
VITE_SERVER_URL='http://localhost:5001'

# Must equal "token" in Backend/PIPE_model/credentials.json (local)
# or the API_TOKEN environment variable on Render (deployed)
VITE_ML_TOKEN='sk_your_token_here'
